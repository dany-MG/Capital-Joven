---
import Nosotros from '../components/Nosotros.astro';
---

<div id="horizontal-scroll" class="flex bg-white">
    <div class="content grid place-items-center w-svw h-svh shrink-0">
        <div class="flex flex-col items-center justify-center max-w-md p-10">
            <!-- Badge superior -->
            <div class="px-5 py-2 rounded-full border border-gray-700 text-xs font-semibold text-gray-400 tracking-widest uppercase">
                Bienestar Nacional
            </div>
            <!-- Línea punteada -->
            <div class="h-16 border-l-2 border-dashed border-gray-700 my-2"></div>
            <!-- Número gigante con efecto -->
            <h3 class="text-8xl md:text-9xl font-bold text-transparent bg-clip-text bg-linear-to-b from-emerald-400 to-cyan-600 tracking-tighter mb-4 pr-2">
                50.8%
            </h3>
            <!-- Texto descriptivo -->
            <p class="text-center text-black text-xl md:text-2xl font-medium leading-relaxed">
                De las personas en México tienen deudas.
            </p>
        </div>
    </div>

    <div class="content grid place-items-center w-svw h-svh shrink-0">
        <div class="flex flex-col items-center justify-center max-w-md p-10">
            <div class="px-5 py-2 rounded-full border border-gray-700 text-xs font-semibold text-gray-400 tracking-widest uppercase">
                Salud Mental
            </div>
            <div class="h-16 border-l-2 border-dashed border-gray-700 my-2"></div>
            <h3 class="text-8xl md:text-9xl font-bold text-transparent bg-clip-text bg-linear-to-b from-emerald-400 to-cyan-600 tracking-tighter mb-4 pr-2">
                49M
            </h3>
            <p class="text-center text-black text-xl md:text-2xl font-medium leading-relaxed">
                De mexicanos se encuentran sometidas a un nivel alto de estrés financiero.
            </p>
        </div>
    </div>

    <div class="content grid place-items-center w-svw h-svh shrink-0">
        <div class="flex flex-col items-center justify-center max-w-md p-10">
            <div class="px-5 py-2 rounded-full border border-gray-700 text-xs font-semibold text-gray-400 tracking-widest uppercase">
                Riesgo de Deuda
            </div>
            <div class="h-16 border-l-2 border-dashed border-gray-700 my-2"></div>
            <h3 class="text-8xl md:text-9xl font-bold text-transparent bg-clip-text bg-linear-to-b from-emerald-400 to-cyan-600 tracking-tighter mb-4 pr-2">
                48.4%
            </h3>
            <p class="text-center text-black text-xl md:text-2xl font-medium leading-relaxed">
                De los mexicanos vive con la preocupación constante de que sus deudas se acumulen.
            </p>
        </div>
    </div>

    <div class="content grid place-items-center w-svw h-svh shrink-0">
        <div class="flex flex-col items-center justify-center max-w-md p-10">
            <div class="px-5 py-2 rounded-full border border-gray-700 text-xs font-semibold text-gray-400 tracking-widest uppercase">
                Impacto Físico
            </div>
            <div class="h-16 border-l-2 border-dashed border-gray-700 my-2"></div>
            <h3 class="text-8xl md:text-9xl font-bold text-transparent bg-clip-text bg-linear-to-b from-emerald-400 to-cyan-600 tracking-tighter mb-4 pr-2">
                34.9%
            </h3>
            <p class="text-center text-black text-xl md:text-2xl font-medium leading-relaxed">
                Reporta experimentar consecuencias físicas (como dolores de cabeza o gastritis) derivadas de problemas de dinero.
            </p>
        </div>
    </div>
</div>

<Nosotros/>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);
    document.addEventListener('DOMContentLoaded', () => {
        const horizontalScroll = document.getElementById('horizontal-scroll');
        const sections = horizontalScroll.querySelectorAll('.content');

        gsap.to(sections, {
            xPercent: -100 * (sections.length - 1),
            ease: "none",
            delay: 0.5,
            scrollTrigger: {
                trigger: horizontalScroll,
                scrub: 1,
                pin: true,
                start: "top top",
                end: () => "+=" + (horizontalScroll.offsetWidth * sections.length - window.innerWidth),
                refreshPriority : 1,
            }
        });
    });
</script>