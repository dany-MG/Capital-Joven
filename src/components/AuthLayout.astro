---
interface Props {
  title: string;
}
const { title } = Astro.props;
import '../styles/global.css';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/logo.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Capital Joven</title>
  </head>
  <body class="bg-black min-h-svh relative overflow-hidden">

    <!-- Auras de fondo (mismo lenguaje del Hero/About) -->
    <div class="fixed -top-40 -left-40 w-[500px] h-[500px] bg-emerald-500/20 blur-[140px] rounded-full pointer-events-none"></div>
    <div class="fixed -bottom-40 -right-40 w-[500px] h-[500px] bg-cyan-500/15 blur-[140px] rounded-full pointer-events-none"></div>

    <!-- Logo / volver al inicio -->
    <a href="/" class="fixed top-6 left-6 z-20 flex items-center gap-2 text-white hover:text-emerald-400 transition-colors duration-300">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m12 19-7-7 7-7"/>
        <path d="M19 12H5"/>
      </svg>
      <span class="text-sm font-medium">Volver al inicio</span>
    </a>

    <main class="relative z-10 flex items-center justify-center min-h-svh px-4 py-12">
      <slot />
    </main>
  </body>
</html>
