---
import SolidButton from "../elements/SolidButton.astro"
import FrostedButton from "../elements/FrostedButton.astro"

const currItem = Astro.url.pathname;
const navItems = [
    { name: "Inicio", path: "" },
    { name: "Docs", path: "https://github.com/dany-MG/Capital-Joven" },
]
---

<header class="fixed top-0 w-svw p-2 z-50">
    <nav class="flex justify-between items-center w-[92%] mx-auto relative">
        <div class="flex-1"><img src="../src/media/logo.png" alt="Capital Joven" class="w-20"></div>
        
        <div class="">
            <ul class="hidden md:flex items-center justify-center gap-11 border rounded-full px-1.5 py-2 bg-zinc-900/30 backdrop-blur-xl border-white/3 font-medium">
                {navItems.map((item) => {
                    const active = currItem === item.path || currItem === item.path + '/';
                    if(item.path.startsWith('https://')){
                        return(
                            <li>
                                <a href={item.path} target="_blank" class={`nav-link px-4 py-1.5 rounded-full transition-all duration-300 ease-in-out 
                                    ${active ? 
                                    'bg-emerald-500 text-black shadow-[0_0_10px_rgba(16,185,129,0.5)]' 
                                    : 'text-white hover:text-emerald-400'
                                }`}>
                                    {item.name}
                                </a>
                            </li>
                        )
                    }
                    return(
                        <li>
                            <a href={item.path} class={`nav-link px-4 py-1.5 rounded-full transition-all duration-300 ease-in-out 
                                ${active ? 
                                'bg-emerald-500 text-black shadow-[0_0_10px_rgba(16,185,129,0.5)]' 
                                : 'text-white hover:text-emerald-400'
                            }`}>
                                {item.name}
                            </a>
                        </li>
                    )
                })}
            </ul>
        </div>
        
        <div class="hidden md:flex flex-1 justify-end items-center gap-10">
            <FrostedButton text="Regístrate" />
            <SolidButton text="Iniciar Sesión" />
        </div>
        
        <button id="mobile-menu-btn" class="md:hidden relative w-10 h-10 flex items-center justify-center text-white focus:outline-none z-50">
            <!-- Icono Hamburguesa -->
            <svg id="icon-burger" class="absolute w-8 h-8 transition-all duration-500 ease-out transform text-emerald-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <!-- Icono X -->
            <svg id="icon-close" class="absolute w-8 h-8 transition-all duration-500 ease-out transform opacity-0 rotate-90 scale-50 text-emerald-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>

        <!-- 2. Hacemos que el menú móvil abarque TODO el ancho y alto superior (top-0 en lugar de top-full) -->
        <div id="mobile-menu" class="fixed top-0 left-0 w-svw h-[50svh] flex flex-col bg-zinc-900/60 backdrop-blur-xl border-b border-white/10 pt-20 pb-6 gap-6 md:hidden shadow-2xl transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] opacity-0 -translate-y-full pointer-events-none origin-top -z-10">
            <ul class="flex flex-col gap-4 text-center font-medium ">
                {navItems.map((item) => {
                    return(
                        <li>
                            <a href={item.path} target={item.path.startsWith('https://') ? "_blank" : "_self"} class={`flex justify-center items-center w-[85%] mx-auto px-4 py-3 transition-all duration-300 ease-in-out hover:bg-emerald-500 hover:text-black rounded-full text-white`}>
                                {item.name}
                            </a>
                        </li>
                    )
                })}
            </ul>
            <div class="flex flex-col gap-4 mt-1 pt-6 border-t border-white/10 w-[85%] mx-auto">
                <div class="w-full flex justify-center">
                    <SolidButton text="Iniciar Sesión" class="w-full flex items-center justify-center" />
                </div>
                <div class="w-full flex justify-center">
                    <FrostedButton text="Regístrate" class="w-full flex items-center justify-center" />
                </div>
            </div>
        </div>
    </nav>
</header>

<script>

    document.addEventListener('DOMContentLoaded', () => {
        const navlinks = document.querySelectorAll('.nav-link');
        navlinks.forEach(link => {
            link.addEventListener('click', function(){
                navlinks.forEach(l => {
                    l.classList.remove('bg-emerald-500', 'text-black', 'shadow-[0_0_10px_rgba(16,185,129,0.5)]');
                    l.classList.add('text-white', 'hover:text-emerald-400');
                });
                this.classList.remove('text-white', 'hover:text-emerald-400');
                this.classList.add('bg-emerald-500', 'text-black', 'shadow-[0_0_10px_rgba(16,185,129,0.5)]');
            });
        });

        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const iconBurger = document.getElementById('icon-burger');
        const iconClose = document.getElementById('icon-close');
        let isOpen = false;

        if(mobileMenuBtn && mobileMenu){
            mobileMenuBtn.addEventListener('click', () => {
                isOpen = !isOpen;
                if(isOpen){
                    mobileMenu.classList.remove('opacity-0', '-translate-y-4', 'pointer-events-none');
                    mobileMenu.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
                    iconBurger.classList.add('opacity-0', '-rotate-90', 'scale-50');
                    iconClose.classList.remove('opacity-0', 'rotate-90', 'scale-50');
                    iconClose.classList.add('opacity-100', 'rotate-0', 'scale-100');
                } else {
                    mobileMenu.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
                    mobileMenu.classList.add('opacity-0', '-translate-y-4', 'pointer-events-none');
                    iconBurger.classList.remove('opacity-0', '-rotate-90', 'scale-50');
                    iconClose.classList.remove('opacity-100', 'rotate-0', 'scale-100');
                    iconClose.classList.add('opacity-0', 'rotate-90', 'scale-50');
                }
            });
        }
    });
</script>
