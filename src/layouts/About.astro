<!-- Contenedor principal con fondo oscuro para contrastar con la tarjeta -->
<section id="about" class="relative w-full h-dvh pt-24 bg-black overflow-hidden">
    
    <!-- Resplandor de fondo -->
    <div class="absolute top-10 inset-x-0 mx-auto max-w-4xl h-32 bg-linear-to-r from-blue-700 via-teal-400 to-lime-200 opacity-80 blur-[80px]"></div>

    <!-- Tarjeta principal blanca con bordes súper redondeados -->
    <div class="relative z-10 w-full bg-white rounded-t-[3rem] px-6 py-24 md:py-32 flex flex-col items-center text-center shadow-[0_-10px_40px_rgba(0,0,0,0.3)]">

        <!-- Etiqueta (Badge) superior -->
        <div class="inline-flex items-center justify-center gap-2 px-5 py-2 mb-12 rounded-full border border-gray-200 text-gray-500 font-medium text-sm bg-gray-50/50 backdrop-blur-sm">
            <svg class="w-4 h-4 text-teal-500" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
            <span>Acerca de Capital Joven</span>
        </div>

        <h2 class="max-w-6xl mx-auto text-3xl md:text-5xl lg:text-6xl font-medium leading-[1.3] md:leading-[1.3] tracking-tight text-transparent bg-clip-text bg-linear-to-r from-blue-800 via-teal-500 to-lime-500">
            
            <!-- 1. Parte difuminada (Controlada por opacidad para verse clara/pastel) -->
            <span class="text-white/50">
                <span class="italic">Creemos que el futuro de la gestión financiera es digital,</span> transparente y enfocado en el estudiante. 
            </span>

            <!-- 2. Parte resaltada (Full opacidad y negritas para dar el "golpe" visual) -->
            <span class="text-white/50 font-bold split-section">
                Nuestra plataforma ayuda a los universitarios
            </span>

            <!-- 3. Resto del texto difuminado -->
            <span class="text-white/50">
                a transformar sus finanzas diarias en experiencias intuitivas, mejorando la confianza y el control en su vida financiera.
            </span>
        </h2>
    </div>
</section>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import SplitType from 'split-type';

    gsap.registerPlugin(ScrollTrigger);

    document.fonts.ready.then(() => {
        const splitSections = document.querySelectorAll('.split-section');
        splitSections.forEach((section) => {
            const text = new SplitType(section, { types: 'words,chars' });
            
            gsap.to(text.chars, {
                scrollTrigger: {
                    trigger: section,
                    start: 'top 80%',
                    end: 'top 20%',
                    scrub: false,
                    markers: false,
                },
                delay : 1.5,
                color : 'rgba(255,255,255,0)',
                fontWeight: 900,
                duration: 0.7, 
                ease: "expo.inOut",
                stagger: {
                    each: 0.04,
                }
            });
        });
    });
</script>