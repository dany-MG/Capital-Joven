---
interface Props {
  text: string;
  ref?: string;
  class?: string;
}

const { text, ref } = Astro.props;
---

<a href={ref} class={`px-6 py-2 bg-zinc-900/50 cursor-pointer backdrop-blur-md border border-white/12 rounded-full font-medium  whitespace-nowrap transition-all duration-300 hover:border-emerald-500 hover:shadow-[0_0_10px_rgba(16,185,129,0.4)] hover:scale-105 ${Astro.props.class || ''}`}>
    {text}
</a>