---
---
<section class="relative w-full min-h-svh flex items-center justify-center bg-black overflow-hidden pt-32 pb-16 lg:pt-0 lg:pb-0">
  
  <div class="max-w-7xl mx-auto px-6 lg:px-12 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center w-full z-20">
    
    <div class="relative z-20 flex flex-col items-center lg:items-start text-center lg:text-left gap-6 hero-text w-full pointer-events-none lg:pointer-events-auto">
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-white leading-[1.1] drop-shadow-lg lg:drop-shadow-none">
        Toma el control de tu dinero con <br class="hidden lg:block" />
        <span class="text-7xl text-transparent bg-clip-text bg-linear-to-r from-emerald-400 to-cyan-400 font-[Satoshi-Bold] drop-shadow-md lg:drop-shadow-none">
          <br class="lg:hidden">Capital Joven
        </span>
      </h1>
      <p class="text-gray-200 text-lg md:text-xl max-w-xl leading-relaxed drop-shadow-lg lg:drop-shadow-none font-medium">
        Gestiona tus gastos, planifica tus metas y domina tu economía universitaria sin complicaciones.
      </p>
    </div>

    <div class="absolute inset-0 lg:relative lg:inset-auto w-full lg:w-2xl h-full lg:h-100 flex justify-center items-center z-0 hero-3d pointer-events-auto">
        <div class="absolute inset-0 bg-emerald-500/20 blur-[120px] rounded-full transform scale-75 pointer-events-none"></div>
        <spline-viewer class="w-full h-full" url="https://prod.spline.design/O-z-WYaxyTSooLyH/scene.splinecode"></spline-viewer>
    </div>
    <div class="absolute inset-0 z-10 bg-zinc-900/20 backdrop-blur-xs pointer-events-none lg:hidden"></div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-30 flex flex-col justify-center items-center gap-3 scroll-indicator cursor-default pointer-events-none animate-bounce">
    <span class="text-[10px] md:text-xs uppercase tracking-[0.2em] text-white/40 font-bold">
      Desliza
    </span>
    <div class="flex justify-center items-center">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="30" viewBox="0 0 24 34" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-400 drop-shadow-[0_0_8px_rgba(52,211,153,0.5)]">
        <path d="M12 1v30"/>
        <path d="m19 24-7 7-7-7"/>
      </svg>
    </div>
    
  </div>
</section>

<script type="module" src="https://unpkg.com/@splinetool/viewer@1.12.90/build/spline-viewer.js"></script>
<script>
  import { gsap } from 'gsap';
  document.addEventListener("DOMContentLoaded", () => {
      const tl = gsap.timeline();
      
      tl.from(".hero-text > *", {
        y: 40,
        opacity: 0,
        duration: 1,
        stagger: 0.15,
        ease: "power3.out",
        delay: 0.2
      })
      .from(".hero-3d", {
        opacity: 0,
        scale: 1.1,
        duration: 2,
        ease: "power2.out"
      }, "-=0.8")

      .from(".scroll-indicator", {
        y: -20,
        opacity: 0,
        duration: 1,
        ease: "power2.out"
      }, "-=1.5");
  });
</script>